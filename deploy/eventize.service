[Unit]
Description=Eventize Next.js Application
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/eventize
Environment=NODE_ENV=production
EnvironmentFile=/var/www/eventize/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
